/* ---------------------------------------------------------
   GLOBAL WIDGET SETTINGS
--------------------------------------------------------- */
QWidget {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    color: #F8FAFC;
}

QMainWindow, QWidget#ViewLoginBase, QFrame#LoginPanel {
    background-color: #2E3643;
}

/* ---------------------------------------------------------
   TOP BAR & BRANDING
--------------------------------------------------------- */
QFrame#TopBar, QWidget#HeroPanel, QFrame#FloatingCard, QFrame#StatusBar {
    background-color: #1F2531;
}

QFrame#TopBar {
    border-bottom: 1px solid #141820;
}

QFrame#TopSeparator {
    background-color: #2E3643;
    border-radius: 1px;
}

QLabel#H1Title {
    font-size: 20px;
    font-weight: bold;
    color: #6D7A8B;
}

QLabel#AvatarIcon {
    font-size: 16px;
    background-color: #2E3643;
    border-radius: 17px; 
    color: #94A3B8;
}

/* ---------------------------------------------------------
   SIDEBAR NAVIGATION (TD VIEW)
--------------------------------------------------------- */
QPushButton#SidebarNavInactive, QPushButton#SidebarNavActive {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    text-align: left;
    padding: 14px 20px;
    font-size: 16px;
    font-weight: 600;
    outline: none;
}

QPushButton#SidebarNavInactive {
    color: #94A3B8;
}

QPushButton#SidebarNavInactive:hover {
    border: 1px solid #3B82F6;
    color: #E2E8F0;
    background-color: rgba(59, 130, 246, 0.05);
}

QPushButton#SidebarNavActive {
    border: 1px solid #F97316;
    color: #F97316;
    background-color: rgba(249, 115, 22, 0.05);
}

/* ---------------------------------------------------------
   PANELS & CONTAINERS
--------------------------------------------------------- */
QWidget#HeroPanel {
    border-left: 1px solid #1F2531; 
}

QScrollArea#InvisibleScrollArea {
    border: none;
    background: transparent;
}

QWidget#TransparentGridContainer {
    background: transparent;
}

QFrame#FloatingCard, QDialog#FloatingCard {
    background-color: #1F2531;
    border: 1px solid #141820;
    border-radius: 12px;
}

QLabel#CardTitle {
    font-size: 24px;
    font-weight: bold;
}

QLabel#H2Title {
    font-size: 16px;
    font-weight: bold;
}



/* ---------------------------------------------------------
   INPUTS & FORMS
--------------------------------------------------------- */
QLabel#InputLabel {
    color: #94A3B8;
    font-size: 12px;
    font-weight: bold;
}

/* Aplicado globalmente a todos los campos de texto posibles */
QLineEdit#FormInput, QTextEdit#FormInput, QPlainTextEdit#FormInput, QComboBox#FormInput, QListWidget#FormInput {
    background-color: #1F2531;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 0 15px;
    font-size: 13px;
    color: #F8FAFC;
    selection-background-color: #F97316;
}

QLineEdit#FormInput:focus, QTextEdit#FormInput:focus, QPlainTextEdit#FormInput:focus, QComboBox#FormInput:focus, QListWidget#FormInput:focus {
    border: 1px solid #F97316;
    background-color: #1A1F29;
}

QLineEdit#FormInput::placeholder, QTextEdit#FormInput::placeholder, QPlainTextEdit#FormInput::placeholder {
    color: #64748B;
}

/* ---------------------------------------------------------
   BUTTONS (Especificidad estricta para Linux/GTK Override)
--------------------------------------------------------- */
QPushButton#PrimaryButton, QPushButton#OrangeCTA {
    background-color: #F97316;
    color: #FFFFFF;
    border: none;
    font-weight: bold;
    outline: none;
}

QPushButton#PrimaryButton {
    border-radius: 8px;
    font-size: 16px;
}

QPushButton#OrangeCTA {
    font-size: 15px;
    border-radius: 20px;
    padding: 10px 30px;
}

QPushButton#PrimaryButton:hover, QPushButton#OrangeCTA:hover {
    background-color: #EA580C;
}

QPushButton#PrimaryButton:pressed, QPushButton#OrangeCTA:pressed {
    background-color: #C2410C;
}

QPushButton#PrimaryButton:disabled, QPushButton#OrangeCTA:disabled {
    background-color: #334155; 
    color: #64748B;
}

QPushButton#SecondaryButton {
    background-color: #1F2531;
    color: #F8FAFC;
    border: 1px solid #475569;
    border-radius: 6px;
    font-weight: bold;
    outline: none;
}

QPushButton#SecondaryButton:hover {
    background-color: #2E3643;
}

QPushButton#LinkButton {
    background-color: transparent;
    color: #3B82F6;
    font-size: 12px;
    border: none;
    padding: 0;
    outline: none;
}

QPushButton#LinkButton:hover {
    color: #60A5FA;
    text-decoration: underline;
}

/* ---------------------------------------------------------
   ALERTS & STATUS
--------------------------------------------------------- */
QLabel#ErrorLabel {
    color: #EF4444; 
    font-size: 12px;
    font-weight: bold;
}

QFrame#StatusBar {
    border-top: 1px solid #141820;
}

QLabel#StatusText {
    color: #475569;
    font-size: 10px;
    font-weight: bold;
}

/* ======================================================= */
/* PIPELINE WIZARD COMPONENT                               */
/* ======================================================= */

QFrame#PipelineWizardCard {
    background-color: #1E293B;
    border-radius: 12px;
    border: 1px solid #334155;
}

QLabel#WizardHeader {
    color: #F8FAFC;
    font-size: 16px;
    font-weight: bold;
}

/* --- Nodos (Círculos) --- */
QLabel#StepNodeCompleted, QLabel#StepNodeActive, QLabel#StepNodePending {
    border-radius: 22px; 
    font-size: 16px;
    font-weight: bold;
}

QLabel#StepNodeCompleted {
    background-color: #10B981;
    color: #0F172A;
}

QLabel#StepNodeActive {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: 2px solid #60A5FA;
}

QLabel#StepNodePending {
    background-color: #334155;
    color: #94A3B8;
}

/* --- Títulos debajo de los Nodos --- */
QLabel#StepTitleCompleted { color: #10B981; font-weight: bold; }
QLabel#StepTitleActive { color: #3B82F6; font-weight: bold; }
QLabel#StepTitlePending { color: #94A3B8; }

/* --- Líneas Conectoras --- */
QFrame#StepLineCompleted, QFrame#StepLinePending {
    margin: 0 10px;
}

QFrame#StepLineCompleted {
    border-top: 4px solid #10B981;
}

QFrame#StepLinePending {
    border-top: 4px solid #334155;
}

/* ======================================================= */
/* TOP TABS (VSCode / Modern Browser Style)                */
/* ======================================================= */

QPushButton#TopTabInactive, QPushButton#TopTabActive {
    border: none;
    border-radius: 0px;
    padding: 0 20px;
    font-size: 13px;
    outline: none;
    margin-top: 1px; /* Evita que el borde superior choque */
}

QPushButton#TopTabInactive {
    background-color: transparent;
    color: #64748B;
    border-top: 2px solid transparent;
}

QPushButton#TopTabInactive:hover {
    background-color: #2E3643;
    color: #E2E8F0;
    border-top: 2px solid #475569;
}

QPushButton#TopTabActive {
    background-color: #2E3643; /* Mismo color que el fondo del área de trabajo */
    color: #F8FAFC;
    font-weight: bold;
    border-top: 2px solid #F97316; /* Accent color superior */
    border-left: 1px solid #141820;
    border-right: 1px solid #141820;
}
